{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nuxt: サーバー側 (Node)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Nuxt: クライアント側 (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Nuxt: フルスタック",
      "configurations": ["Nuxt: サーバー側 (Node)", "Nuxt: クライアント側 (Chrome)"]
    }
  ]
}
