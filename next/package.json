{
  "name": "zettaionkan-next",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "sync-public": "node scripts/sync-public.mjs",
    "predev": "npm run sync-public",
    "prebuild": "npm run sync-public",
    "test:smoke": "node scripts/smoke.mjs",
    "db:start": "npx --yes supabase --workdir .. start",
    "db:stop": "npx --yes supabase --workdir .. stop",
    "db:reset": "npx --yes supabase --workdir .. db reset",
    "db:status": "npx --yes supabase --workdir .. status",
    "db:env": "node scripts/local-env.mjs",
    "setup:local": "npm run db:start && npm run db:env"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.90.1",
    "abcjs": "^6.6.0",
    "google-auth-library": "^10.9.1",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.64.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
