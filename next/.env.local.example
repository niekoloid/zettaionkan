# Hosted DEV project (zettaionkan-dev):  cp .env.local.example .env.local
# `npm run dev` uses .env.local unless .env.development.local exists (local Supabase, see below).
# Never put production keys here.

NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_dev_supabase_anon_key

# Stripe: test key only (pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Contact form (optional)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# /admin/video-gen (optional)
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_CLOUD_ACCESS_TOKEN=
# the API routes use Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS)

# The Nuxt app's names (SUPABASE_URL / SUPABASE_KEY, VITE_*, NUXT_PUBLIC_*) also work.
