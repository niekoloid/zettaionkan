# cp .env.example .env   (in this next/ directory)
# The Nuxt app's variable names (SUPABASE_URL / SUPABASE_KEY, VITE_*, NUXT_PUBLIC_*) also work.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Stripe (subscription screen only; use the test key) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Contact form (optional) ---
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# --- /admin/video-gen (optional) ---
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_CLOUD_ACCESS_TOKEN=
# the API routes use Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS)
