# Local Supabase (supabase start). Generated for you by `npm run db:env`.
# .env.development.local wins over .env.local during `npm run dev`, so the hosted dev
# values stay in .env.local and you can switch back by deleting this file.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=copy-from-`npm run db:status`
