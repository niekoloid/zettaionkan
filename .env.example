# コピーして .env を作成してください: cp .env.example .env
# ※ 本番キーは入れず、Supabase / Stripe の開発(テスト)用の値を使うこと

# --- Supabase (必須) ---
# ダッシュボード > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your-anon-key

# --- Stripe (購読画面を試す場合のみ) ---
# テストモードの公開可能キー (pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=

# --- お問い合わせフォーム (任意) ---
NUXT_PUBLIC_FORMSPREE_ENDPOINT=
RESEND_API_KEY=

# --- 管理画面の動画生成 (任意 / /admin/video-gen のみ) ---
VITE_GOOGLE_CLOUD_PROJECT_ID=
VITE_GOOGLE_CLOUD_ACCESS_TOKEN=
